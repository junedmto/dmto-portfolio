---
layout: layouts/base.njk
title: DMTO
description: Creative design across graphic design, 3D, motion, and interactive web.
---
{#
  index.njk — the homepage.
  Loops over every file in src/projects/ (newest first, see .eleventy.js)
  and renders one tile per project. Add/remove/reorder projects from the
  /admin panel and this grid updates on its own — nothing here needs to
  change when you add a project.

  Layout note: this is a "justified" gallery — every row is a different
  height, chosen so the images in it line up and fill the full width
  without being cropped or squashed. That works by giving each tile a
  flex-grow and flex-basis proportional to its real width-to-height
  ratio (measured at build time by the aspectRatio filter). See the
  .gallery-row rules in style.css for how the two halves fit together.

  The "cover" line accepts either gallery format: a plain path string
  (what the CMS writes) or an {image: path} object (older hand-written
  files).
#}

{# homeTiles (see .eleventy.js) gives one tile per visible project, and
   splitRows cuts them into rows using the "Photos per row" setting from
   Pages > Homepage in the CMS. Tiles left over flow automatically. #}
{% set tiles = collections.projects | homeTiles %}
{% set rows = tiles | splitRows(home.row_layout) %}
{% if rows.length %}
<div class="gallery-stack">
  {% for row in rows %}
  <div class="justified-gallery{% if row.manual %} justified-gallery--manual{% endif %}">
    {% for tile in row.items %}
    {% set ratio = tile.cover | aspectRatio %}
    {# flex-grow is the ratio x 1000: grow factors that add up to less
       than 1 would leave a row short of the full width. #}
    {% set sizing = ("flex: " + (ratio * 1000) + " 1 0; aspect-ratio: " + ratio + ";") if row.manual else ("flex-grow: " + (ratio * 1000) + "; flex-basis: calc(" + ratio + " * 24rem); aspect-ratio: " + ratio + ";") %}
    <a class="justified-gallery__item" href="{{ tile.url | url }}" style="{{ sizing }}">
      {% if tile.isVideo %}
      <video src="{{ tile.cover | url }}" muted loop playsinline autoplay preload="metadata" aria-label="{{ tile.title }}"></video>
      {% else %}
      <img src="{{ tile.cover | url }}" alt="{{ tile.title }}" loading="lazy">
      {% endif %}
      <div class="justified-gallery__caption">
        <p class="justified-gallery__title">{{ tile.title }}</p>
        {% if tile.category %}<p class="justified-gallery__meta">{{ tile.category }}</p>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% else %}
<div class="wrap">
  <p class="work-empty">Projects added from /admin will appear here.</p>
</div>
{% endif %}
