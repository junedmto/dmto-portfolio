{#
  index.njk — the homepage.
  Loops over every file in src/projects/ (newest first, see .eleventy.js)
  and renders one tile per project. Add/remove/reorder projects from the
  /admin panel and this grid updates on its own — nothing here needs to
  change when you add a project.

  Layout note: this is a "justified" gallery — every row is a different
  height, chosen so the images in it line up and fill the full width
  without being cropped or squashed. That works by giving each tile a
  flex-grow and flex-basis proportional to its real width-to-height
  ratio (measured at build time by the aspectRatio filter). See the
  .gallery-row rules in style.css for how the two halves fit together.

  The "cover" line accepts either gallery format: a plain path string
  (what the CMS writes) or an {image: path} object (older hand-written
  files).
#}

{% if collections.projects.length %}
<div class="justified-gallery">
  {% for project in collections.projects %}
  {% set gallery = project.data.gallery %}
  {% set first = gallery[0] if gallery and gallery.length else none %}
  {% set cover = (first.image if first.image else first) if first else none %}
  {% set displayCategory = project.data.category_other if project.data.category_other else project.data.category %}
  {% if cover %}
  {% set ratio = cover | aspectRatio %}
  <a class="justified-gallery__item" href="{{ project.url | url }}"
     style="flex-grow: {{ ratio }}; flex-basis: calc({{ ratio }} * 24rem); aspect-ratio: {{ ratio }};">
    <img src="{{ cover | url }}" alt="{{ project.data.title }}" loading="lazy">
    <div class="justified-gallery__caption">
      <p class="justified-gallery__title">{{ project.data.title }}</p>
      {% if displayCategory %}<p class="justified-gallery__meta">{{ displayCategory }}</p>{% endif %}
    </div>
  </a>
  {% endif %}
  {% endfor %}
</div>
{% else %}
<div class="wrap">
  <p class="work-empty">Projects added from /admin will appear here.</p>
</div>
{% endif %}
