---
layout: layouts/base.njk
---
{#
  layouts/project.njk
  --------------------
  Every file in src/projects/*.md is rendered through this template, so
  every project page automatically has the same shape: a header with the
  title and category on the left and the description on the right, then
  the gallery. This is the one place to change if you ever want to adjust
  what a project page looks like — it updates all of them.

  "content" below is the Markdown body of the project file, in case you
  ever want to write extra copy under the description. "gallery" is the
  list of images set in the CMS (or written by hand in the front matter).
#}

<article>
  {% set displayCategory = category_other if category_other else category %}

  {# Two columns across the full page width: title with the category
     underneath on the left, the description on the right. #}
  <header class="project-header">
    <div class="project-header__title">
      <h1>{{ title }}</h1>
      {% if displayCategory %}<p class="project-header__category">{{ displayCategory }}</p>{% endif %}
    </div>

    <div class="project-header__description">
      {% if description %}<p class="project-header__text">{{ description }}</p>{% endif %}
      {{ content | safe }}
    </div>
  </header>

  {# The gallery spans the full page width with only its own side inset,
     exactly like the homepage grid. galleryRows (see .eleventy.js) splits
     it into rows: the ones set in "Photos per row" in the CMS come first
     (each fills the full width), and anything left over flows
     automatically. Each item is a photo or, if the file is a video, a
     looping muted video. #}
  {% set rows = gallery | galleryRows(row_layout) %}
  {% if rows.length %}
  <div class="gallery-stack">
    {% for row in rows %}
    <div class="justified-gallery{% if row.manual %} justified-gallery--manual{% endif %}">
      {% for media in row.items %}
      {% set ratio = media.src | aspectRatio %}
      {# flex-grow is the ratio x 1000: grow factors that add up to less
         than 1 (e.g. one portrait photo alone) would leave the row short
         of the full width. Manual rows share the width in proportion to each ratio; automatic
         rows use the wrapping basis so they break where they fit. #}
      {% set sizing = ("flex: " + (ratio * 1000) + " 1 0; aspect-ratio: " + ratio + ";") if row.manual else ("flex-grow: " + (ratio * 1000) + "; flex-basis: calc(" + ratio + " * 20rem); aspect-ratio: " + ratio + ";") %}
      {% if media.isVideo %}
      <figure class="justified-gallery__item justified-gallery__item--video" style="{{ sizing }}">
        <video src="{{ media.src | url }}" muted loop playsinline autoplay preload="metadata" data-video aria-label="{{ title }} — video {{ loop.index }}"></video>
      </figure>
      {% else %}
      <figure class="justified-gallery__item justified-gallery__item--zoom" data-lightbox-trigger style="{{ sizing }}">
        <img src="{{ media.src | url }}" alt="{{ title }} — image {{ loop.index }}" loading="lazy">
      </figure>
      {% endif %}
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="project-footer">
    <a class="back-link" href="{{ '/' | url }}">← Back to work</a>
  </div>
</article>

<!-- Full-screen viewer: clicking any gallery image opens it larger.
     Markup lives here once; behaviour is in assets/js/main.js -->
<div class="lightbox" data-lightbox>
  <img src="" alt="" data-lightbox-image>
</div>
