{#
  base.njk
  --------
  The shell every page is wrapped in: head (title, meta, fonts, css),
  the top nav, then whatever the page itself contains, then the footer.
  Individual pages (index.njk, layouts/project.njk, layouts/page.njk)
  only need to worry about what goes inside main.

  Note for future edits: comments in this file use Nunjucks-style
  curly-brace comments, not plain HTML comments. A plain HTML comment
  is just text to Nunjucks, so a template expression written inside one
  still runs and leaks its output into the page.
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title != site.name %} — {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {# Pages that set "noindex: true" in their data (the unfinished look-around
     About page and its photo-shoot helper) ask search engines to skip them. #}
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}

  <!-- Social share preview tags (what shows up when a link is pasted into
       iMessage, Instagram, LinkedIn, etc). Each project page overrides
       "image" with its own first gallery photo. -->
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  {% if image %}<meta property="og:image" content="{{ image | url }}">{% endif %}
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">

  {# The loading screen and page transitions: this tiny script decides, before
     anything is drawn, what plays. Arriving from a click on another page of
     the site: the curtain lifts (no logo). First page of a visit: the full
     loading screen. Set ONLY_FIRST_VISIT to false to play the full loading
     screen on every page load instead of once per visit. #}
  <script>
    (function () {
      var ONLY_FIRST_VISIT = true;
      var r = document.documentElement;
      var nav = false;
      try { nav = sessionStorage.getItem("dmto-nav"); sessionStorage.removeItem("dmto-nav"); } catch (e) {}
      if (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (nav) {
        r.classList.add("is-loading", "is-transition");
      } else {
        try { if (ONLY_FIRST_VISIT && sessionStorage.getItem("dmto-loaded")) return; } catch (e) {}
        r.classList.add("is-loading");
      }
      setTimeout(function () { r.classList.remove("is-loading"); }, 8000); // safety net
    })();
  </script>
  <link rel="preload" href="{{ '/assets/fonts/DMTOPixel.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/loader.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/gradual-blur.css' | url }}">

  <!-- Poppins carries the text wordmark and headings, Inter carries
       everything meant to be read (nav, body copy, UI text). -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Poppins:wght@500;600;700;800&family=Source+Serif+4:wght@700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  {# Extra stylesheets a page asks for with "extraCss: [...]". #}
  {% for css in extraCss %}<link rel="stylesheet" href="{{ css | url }}">{% endfor %}
  {# The playground at the bottom of every page (see below). #}
  {% if not noReveal %}<link rel="stylesheet" href="{{ '/assets/css/playground.css' | url }}">{% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  {# The loading screen (see assets/css/loader.css and assets/js/loader.js). #}
  <div class="loader" data-loader aria-hidden="true">
    <div class="loader__layer loader__layer--back"></div>
    <div class="loader__layer loader__layer--front">
      <div class="loader__center">
        {% if hasLogo %}
        <img class="loader__logo" src="{{ site.logo | url }}" alt="">
        {% else %}
        <span class="loader__logo loader__logo--text">{{ site.name }}</span>
        {% endif %}
        <span class="loader__count" data-loader-count>000</span>
      </div>
    </div>
  </div>

  <header class="site-nav">
    <div class="site-nav__row">
      <a class="site-nav__brand" href="{{ '/' | url }}">
        {% if hasLogo %}
        <img src="{{ site.logo | url }}" alt="{{ site.name }}" class="site-nav__logo">
        {% else %}
        {{ site.name }}
        {% endif %}
      </a>
      <nav class="site-nav__links">
        {# Each menu item is an image if its file exists (see "nav_about" and
           "nav_contact" in src/_data/site.json), otherwise plain text. #}
        <a href="{{ '/about/' | url }}" {% if page.url == ('/about/' | url) %}aria-current="page"{% endif %}>
          {% if navImages.about %}<img src="{{ site.nav_about | url }}" alt="About" class="site-nav__link-img">{% else %}About{% endif %}
        </a>
        <a href="{{ '/contact/' | url }}" {% if page.url == ('/contact/' | url) %}aria-current="page"{% endif %}>
          {% if navImages.contact %}<img src="{{ site.nav_contact | url }}" alt="Contact" class="site-nav__link-img">{% else %}Contact{% endif %}
        </a>
      </nav>
    </div>
  </header>

  {# The page itself sits on a white sheet (page-shell--over). Under it, fixed
     to the bottom of the window, is the playground; the empty space at the end
     (reveal-space) lets you keep scrolling to uncover it. Pages that set
     "noReveal: true" in their data skip all of this. #}
  <div class="page-shell{% if not noReveal %} page-shell--over{% endif %}">
  <main>
    {{ content | safe }}
  </main>

  {% if not hideFooter and noReveal %}
  <footer class="site-footer">
    <div class="wrap">
      <span>{{ site.name }} · {{ currentYear }}</span>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>
    </div>
  </footer>
  {% endif %}
  </div>

  {% if not noReveal %}
  <div class="reveal-space" data-reveal-spacer aria-hidden="true"></div>
  {% include "partials/playground-reveal.njk" %}
  {% endif %}

  {# The soft blur along the bottom edge of the screen (assets/js/gradual-blur.js). #}
  <div class="gradual-blur" data-gradual-blur aria-hidden="true"></div>

  <script src="{{ '/assets/js/loader.js' | url }}"></script>
  <script src="{{ '/assets/js/gradual-blur.js' | url }}"></script>
  <script src="{{ '/assets/js/main.js' | url }}"></script>
  {# Extra scripts a page asks for with "extraJs: [...]". #}
  {% for js in extraJs %}<script src="{{ js | url }}"></script>{% endfor %}
  {% if not noReveal %}<script src="{{ '/assets/js/playground.bundle.js' | url }}"></script>{% endif %}
</body>
</html>
