---
layout: layouts/base.njk
---
{#
  layouts/about.njk
  The page opens with the interactive workspace picture (60 pictures that
  follow the mouse, see assets/js/workspace.js), filling the window and fixed
  in place. As you scroll, a white sheet slides up over it, holding
  src/about.md as four columns across the full page width, and then the video
  (if a YouTube link is set in about.md). Columns:

    1. Bio       - "content" below, the Markdown body of about.md. The
                   first paragraph is shown bolder (see style.css).
    2. Education and Publications - structured lists from the front matter
    3. Skills    - a plain list from the front matter
    4. Photo     - "photo" in the front matter, set from /admin. If no
                   photo is set, the column is simply left out.

  Everything here is editable from /admin -> Pages -> About. The headings
  (Education, Publications, Skills) are written directly in this file.

  The page title is kept in the HTML for screen readers and search
  engines, but hidden visually, since the nav already shows where you are.
#}

<h1 class="visually-hidden">{{ title }}</h1>

{# The workspace picture: fixed behind everything. The transparent opening
   below it is what you see first; the sheet then slides over it. #}
<canvas class="ws ws--behind" data-workspace
        data-frames="60"
        data-path="{{ '/assets/img/workspace/' | url }}"
        data-ext="webp"
        data-invert="false"
        role="img"
        aria-label="An interactive view of the workspace. Move the mouse left and right, up and down, to look around."></canvas>

<section class="ws-hero" aria-hidden="true">
  <p class="ws__status" data-workspace-status></p>
  <span class="ws-hero__cue">Scroll</span>
</section>

{# The white sheet that slides over the picture. #}
<div class="ws-sheet">

<div class="about">

  <section class="about__col about__bio">
    {{ content | safe }}
  </section>

  <section class="about__col">
    {% if education and education.length %}
    <div class="about__block">
      <h2>Education</h2>
      <ul class="about__list">
        {% for item in education %}
        <li>{{ item.school }} | {{ item.degree }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if publications and publications.length %}
    <div class="about__block">
      <h2>Publications</h2>
      <ul class="about__list">
        {% for item in publications %}
        <li>
          {{ item.title }}
          {% if item.url %}<a class="about__link" href="{{ item.url }}" target="_blank" rel="noopener">{{ item.url }}</a>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </section>

  <section class="about__col">
    {% if skills and skills.length %}
    <div class="about__block">
      <h2>Skills</h2>
      {# Accepts a plain list of names, or the older {skill: name} form. #}
      <ul class="about__list about__list--tight">
        {% for skill in skills %}
        <li>{{ skill.skill if skill.skill else skill }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </section>

  {% if photo %}
  <div class="about__col about__photo">
    <img src="{{ photo | url }}" alt="Portrait of June">
  </div>
  {% endif %}

</div>

{# The video, under the information: the "youtube" line in about.md. Leave it
   empty to hide it. #}
{% include "partials/hero-video.njk" %}

</div>
